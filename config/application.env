# Application Configuration
# Customize for your environment

## Java Application Settings
APP_NAME=ekart
APP_VERSION=1.0.0
APP_PORT=8080

## Database Configuration
DB_HOST=mysql-service
DB_PORT=3306
DB_NAME=ekart_db
DB_USER=ekart_user
# DB_PASSWORD is stored in Kubernetes Secret

## Jenkins Configuration
JENKINS_URL=http://jenkins-server:8080
JENKINS_USER=jenkins
# JENKINS_TOKEN is stored in Jenkins Credentials

## SonarQube Configuration
SONARQUBE_URL=http://sonarqube-server:9000
SONARQUBE_PROJECT_KEY=ekart
# SONARQUBE_TOKEN is stored in Jenkins Credentials

## Nexus Configuration
NEXUS_URL=http://nexus-server:8081
NEXUS_REPOSITORY=maven-releases
NEXUS_USER=jenkins
# NEXUS_PASSWORD is stored in Jenkins Credentials

## Docker Registry
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=username
# DOCKER_PASSWORD is stored in Jenkins Credentials

## AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
EKS_CLUSTER_NAME=my-cluster
ECR_REGISTRY_ID=123456789012.dkr.ecr.ap-south-1.amazonaws.com

## Email Notification
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD is stored in Jenkins Credentials
EMAIL_FROM=jenkins@company.com
EMAIL_TO=team@company.com

## Security
ENABLE_HTTPS=false  # Set to true in production
ENFORCE_AUTHENTICATION=true
REQUIRE_SIGNED_COMMITS=false

## Logging
LOG_LEVEL=INFO
ENABLE_AUDIT_LOG=true
LOG_RETENTION_DAYS=30
